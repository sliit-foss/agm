---
import Layout from "@/layouts/Layout.astro";
import { AgendaData } from "@/data/2026-AgendaData";
---

<Layout title="FOSS AGM 2026" />

{
  AgendaData.map((item) => (
    <div class="agenda-item">
      <h2>{item.title}</h2>
      <p>{item.time}</p>
      <img src={item.imageURL} alt={item.name} class="w-20" />
      <p>{item.name}</p>
      <p>{item.position}</p>
    </div>
  ))
}
